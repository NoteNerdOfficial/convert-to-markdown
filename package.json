{
  "name": "doc-to-markdown",
  "version": "0.1.0",
  "description": "Obsidian plugin: convert PDF/DOCX/PPTX/XLSX into clean Markdown, deterministically.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint src/"
  },
  "keywords": [],
  "author": "notenerd",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "@xmldom/xmldom": "^0.9.10",
    "esbuild": "^0.17.19",
    "eslint": "^9.30.1",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.35.1"
  },
  "dependencies": {
    "pdfjs-dist": "^4.8.69",
    "tesseract.js": "^7.0.0"
  }
}
